1. Find Blocking Sessions

Use this query to see blocked and blocking sessions:

SELECT
    s1.sid || ',' || s1.serial# AS blocked_session,
    s1.username AS blocked_user,
    s2.sid || ',' || s2.serial# AS blocking_session,
    s2.username AS blocking_user,
    s1.event,
    s1.seconds_in_wait
FROM v$session s1
JOIN v$session s2
    ON s1.blocking_session = s2.sid
WHERE s1.blocking_session IS NOT NULL;


2. Find All Blocking Sessions:

SELECT
    sid,
    serial#,
    username,
    machine,
    program,
    status
FROM v$session
WHERE sid IN (
    SELECT blocking_session
    FROM v$session
    WHERE blocking_session IS NOT NULL
);

3. Generate Kill Session Commands:

SELECT
    'ALTER SYSTEM KILL SESSION '''
    || sid || ',' || serial# ||
    ''' IMMEDIATE;' AS kill_command
FROM v$session
WHERE sid IN (
    SELECT blocking_session
    FROM v$session
    WHERE blocking_session IS NOT NULL
);


4. Automatic Script to Kill Blocking Sessions

Use carefully in production, because killing sessions can roll back transactions and impact users.

SET HEADING OFF
SET FEEDBACK OFF

SPOOL kill_blockers.sql

SELECT
    'ALTER SYSTEM KILL SESSION '''
    || sid || ',' || serial# ||
    ''' IMMEDIATE;'
FROM v$session
WHERE sid IN (
    SELECT DISTINCT blocking_session
    FROM v$session
    WHERE blocking_session IS NOT NULL
);

SPOOL OFF

@kill_blockers.sql


5. Safer Version (Blockers Waiting More Than 5 Minutes)

SELECT DISTINCT
    'ALTER SYSTEM KILL SESSION '''
    || s2.sid || ',' || s2.serial# ||
    ''' IMMEDIATE;' AS kill_cmd
FROM v$session s1
JOIN v$session s2
    ON s1.blocking_session = s2.sid
WHERE s1.seconds_in_wait > 300;

