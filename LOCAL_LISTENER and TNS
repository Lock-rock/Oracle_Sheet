Create listener.ora

mkdir -p $ORACLE_HOME/network/admin

cat > $ORACLE_HOME/network/admin/listener.ora <<EOF
LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = dbserver)(PORT = 1521))
    )
  )

SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = ORCL)
      (ORACLE_HOME = /u01/app/oracle/product/19.0.0/dbhome_1)
      (SID_NAME = ORCL)
    )
  )
EOF


Set permissions:
chown oracle:oinstall $ORACLE_HOME/network/admin/listener.ora
chmod 644 $ORACLE_HOME/network/admin/listener.ora


use alos this:

$ cat  /data/app/oracle/product/19.0/db_home/network/admin/listener.ora
# listener.ora Network Configuration File: /data/app/oracle/product/19.0/db_home/network/admin/listener.ora
# Generated by Oracle configuration tools.

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = 10.10.2.131)(PORT = 1521))
      (ADDRESS = (PROTOCOL = IPC)(KEY = EXTPROC1521))
    )
  )


