long running query and CPU consumming query:

SELECT sql_id,
       ROUND(cpu_time / 1000000 / 60, 2) AS cpu_minutes,
       executions,
       SUBSTR(sql_text, 1, 80) AS sql_text
FROM v$sql
ORDER BY cpu_time DESC
FETCH FIRST 20 ROWS ONLY;


