4. start redef
BEGIN
DBMS_REDEFINITION.START_REDEF_TABLE( uname => 'PEGADATA',orig_table => 'ITGI_CLM_STG',int_table => 'ITGI_CLM_STG_INTERIM', options_flag => DBMS_REDEFINITION.CONS_USE_PK);
END;
/

