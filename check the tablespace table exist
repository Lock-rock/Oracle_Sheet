Check table and the size which tablespace lies:

SELECT owner, segment_name, segment_type, sum(bytes)/1024/1024/1024 "Size (GB)" 
FROM dba_segments 
WHERE tablespace_name = 'USERS' 
GROUP BY owner, segment_name, segment_type 
ORDER BY 4 DESC;


SELECT owner, TO_CHAR( SUM( bytes )/1024/1024, '999,999,999' ) mb FROM dba_segments WHERE tablespace_name = 'USERS' GROUP BY owner ORDER BY SUM( bytes );
select * from dba_segments where tablespace_name = 'USERS'
select * from dba_users where default_tablespace = 'USERS'


check tabespase in auto increase:
SELECT tablespace_name,
       file_name,
       autoextensible,
       bytes/1024/1024 AS current_mb,
       maxbytes/1024/1024 AS max_mb
FROM dba_data_files
ORDER BY tablespace_name;

check tablespace with autoexted on base of 32 gb.
SELECT 
    tablespace_name,
    ROUND(tablespace_size * 8192 / 1024 / 1024, 2) AS max_size_mb,
    ROUND(used_space * 8192 / 1024 / 1024, 2) AS used_space_mb,
    ROUND((tablespace_size - used_space) * 8192 / 1024 / 1024, 2) AS true_free_space_mb,
    ROUND(used_percent, 2) AS used_percent
FROM 
    dba_tablespace_usage_metrics
ORDER BY 
    used_percent DESC;
