-- Set up formatting
COLUMN OWNER FORMAT A10
COLUMN DIRECTORY_NAME FORMAT A30
COLUMN DIRECTORY_PATH FORMAT A100
SET LINESIZE 200
SET PAGESIZE 200

-- Select directory information
SELECT 
    OWNER, 
    DIRECTORY_NAME, 
    DIRECTORY_PATH 
FROM 
    ALL_DIRECTORIES;


CREATE OR REPLACE DIRECTORY EXPORT AS '/backup/expimp';
