SET LINESIZE 200
SET PAGESIZE 100
COLUMN privilege FORMAT A30

-- Query for system privileges
SELECT * 
FROM dba_sys_privs 
WHERE grantee = 'USERNAME';

-- Query for object privileges
SELECT * 
FROM dba_tab_privs 
WHERE grantee = 'USERNAME';

-- Query for role privileges
SELECT * 
FROM dba_role_privs 
WHERE grantee = 'USERNAME';
